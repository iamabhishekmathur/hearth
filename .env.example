# ===========================================
# Hearth Configuration
# ===========================================

# Database
DATABASE_URL=postgresql://hearth:hearth@localhost:5432/hearth

# Redis
REDIS_URL=redis://localhost:6379

# Security
SESSION_SECRET=change-me-to-a-random-string
ENCRYPTION_KEY=change-me-to-64-hex-chars  # openssl rand -hex 32

# LLM Providers (at least one required)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OLLAMA_BASE_URL=http://localhost:11434

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/oauth/google/callback

# App
NODE_ENV=development
API_PORT=8000
WEB_PORT=3000
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# Dev-only: auto-attach this user on every request (skips login form).
# Ignored when NODE_ENV=production. User must exist in DB.
# DEV_AUTO_LOGIN=admin@hearth.local

# Sign in with ChatGPT — let users spend their own ChatGPT plan (optional)
# CHATGPT_PLAN_ENABLED=true
# CHATGPT_CLIENT_ID=            # only for OpenAI-approved hosted deployments
# CHATGPT_REDIRECT_URI=         # defaults to http://127.0.0.1:<API_PORT>/api/v1/auth/chatgpt/callback

# SSO callback verifier secret (required to enable POST /api/v1/auth/sso/callback)
# SSO_CALLBACK_SECRET=
